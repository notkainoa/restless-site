---
// System Settings → General → Login Items & Extensions, with Restless's
// background item switched on.
import EyeMark from '../EyeMark.astro';
---

<div class="ui-window ui-settings">
  <div class="ui-titlebar">
    <span class="ui-lights" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="ui-title">Login Items &amp; Extensions</span>
  </div>
  <div class="ui-settings-body">
    <h4>Login Items &amp; Extensions</h4>
    <p class="ui-sub">Items that open automatically when you log in, and apps that run in the background.</p>
    <p class="ui-caption">Open at Login</p>
    <div class="ui-group">
      <div class="ui-row">
        <span class="ui-app"><EyeMark id="li1" size={22} /> Restless</span>
        <span class="ui-sub">Application</span>
      </div>
    </div>
    <p class="ui-caption">Allow in the Background</p>
    <div class="ui-group">
      <div class="ui-row selected">
        <span class="ui-app">
          <EyeMark id="li2" size={22} />
          <span>
            <span style="display:block">Restless</span>
            <span class="ui-sub" style="display:block">1 item: Restless Helper</span>
          </span>
        </span>
        <span class="ui-switch small is-on"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .selected {
    background: rgb(255 255 255 / 0.05);
  }
</style>
