---
// The right end of the macOS menu bar, with Restless's eye in it.
import Icon from '../Icon.astro';

interface Props {
  time: string;
  battery: number;
  glyph?: 'eye' | 'eye-fill' | 'eye-slash';
  open?: boolean;
  /** Render all three glyphs so a script can switch them with data-glyph-state. */
  live?: boolean;
}
const { time, battery, glyph = 'eye-fill', open = false, live = false } = Astro.props;
const glyphs = live ? (['eye-slash', 'eye', 'eye-fill'] as const) : [glyph];
---

<div class="ui-menubar">
  <span class:list={['ui-glyph', { 'is-open': open }]} aria-label="Restless">
    {
      glyphs.map((g) => (
        <span class="mb-g" data-glyph={g}>
          <Icon name={g} size={17} />
        </span>
      ))
    }
  </span>
  <span class="ui-batt">
    {battery}%
    <svg width="25" height="12" viewBox="0 0 25 12" aria-hidden="true"
      ><rect x="0.5" y="0.5" width="21" height="11" rx="3" fill="none" stroke="currentColor" stroke-opacity="0.55"></rect><rect
        x="2"
        y="2"
        width={Math.round((18 * battery) / 100)}
        height="8"
        rx="1.6"
        fill="currentColor"></rect><path d="M23 4v4" stroke="currentColor" stroke-opacity="0.55" stroke-width="1.4" stroke-linecap="round"
      ></path></svg
    >
  </span>
  <span>{time}</span>
</div>

<style>
  .mb-g {
    display: grid;
    place-items: center;
  }
  :global([data-glyph-state]) .mb-g {
    display: none;
  }
  :global([data-glyph-state='eye']) .mb-g[data-glyph='eye'],
  :global([data-glyph-state='eye-fill']) .mb-g[data-glyph='eye-fill'],
  :global([data-glyph-state='eye-slash']) .mb-g[data-glyph='eye-slash'] {
    display: grid;
  }
</style>
