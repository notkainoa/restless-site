---
// The close: the download on the deep indigo of the icon's tile, and the
// facts that make it safe to install.
import { REPO_URL, type Release } from '../lib/release';

interface Props {
  release: Release;
}
const { release } = Astro.props;
---

<section id="download" class="closing" aria-labelledby="closing-title">
  <div class="field wrap">
    <div class="words">
      <h2 id="closing-title" class="closing-line" data-reveal>Close the lid tonight.</h2>
      <p class="after" data-reveal style="--i:1">
        Download {release.assetName}, unzip it and move Restless to Applications. It opens with every switch off, so
        nothing changes until you flip one.
      </p>
      <div class="actions" data-reveal style="--i:2">
        <a class="button" href={release.downloadUrl}>Download for Mac</a>
        <a class="link" href={release.notesUrl}>Release notes</a>
      </div>
      <p class="amped" data-reveal style="--i:3">
        Coming from Amped? Restless copies your settings the first time it runs.
        <a class="link" href={`${REPO_URL}#moving-from-amped`}>Moving from Amped</a>
      </p>
    </div>

    <ul class="facts" data-reveal style="--i:2" aria-label="About the download">
      <li>Signed with a Developer ID</li>
      <li>Notarized by Apple</li>
      <li>Open source, MIT</li>
      <li>Updates itself with Sparkle</li>
      <li>macOS 26 or newer</li>
    </ul>
  </div>
</section>

<style>
  .closing {
    margin-top: clamp(6rem, 10vw, 9rem);
    background: var(--deep);
    color: var(--ink);
  }

  .field {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: center;
    padding-block: clamp(4rem, 9vw, 8rem);
  }

  .words {
    grid-column: 1 / span 6;
    align-self: end;
  }

  .closing-line {
    font-size: var(--step-display);
    line-height: 0.92;
    letter-spacing: -0.055em;
    max-width: 8ch;
  }

  .after {
    max-width: 40ch;
    margin-top: 1.5rem;
    font-size: var(--step-body);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    margin-top: 1.75rem;
  }

  .amped {
    max-width: 44ch;
    margin-top: 2rem;
    font-size: var(--step-small);
  }

  .facts {
    grid-column: 8 / span 5;
    align-self: end;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step-lead);
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  @media (max-width: 899px) {
    .field {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 2.5rem;
      padding-block: 3rem;
    }

    .closing-line {
      font-size: var(--step-display);
    }

    .words,
    .facts {
      align-self: stretch;
    }

    .actions .button {
      width: 100%;
      min-height: 52px;
    }
  }
</style>
