---
// "A single quiet line", plus the credits it owes.
import { DOWNLOAD_PAGE, REPO_URL } from '../lib/release';
---

<footer class="footer wrap">
  <div class="line">
    <p class="what">Restless, a menu bar app for macOS</p>
    <nav aria-label="Project" class="links">
      <a class="plain-link" href={REPO_URL}>GitHub</a>
      <a class="plain-link" href={`${DOWNLOAD_PAGE}#all-versions`}>Releases</a>
      <a class="plain-link" href={`${REPO_URL}/blob/main/LICENSE`}>License</a>
    </nav>
    <p class="who">© 2026 Kainoa Newton</p>
  </div>
  <p class="credits">
    Restless began as a fork of <a class="link" href="https://github.com/gustaferiksson/amped">Amped</a> by Gustaf
    Eriksson, and its panel is adapted from <a class="link" href="https://github.com/robinebers/openusage">OpenUsage</a>;
    it isn’t affiliated with either. The share image uses
    <a class="link" href="https://commons.wikimedia.org/wiki/File:ETH-BIB-Moon,_New_York,_March_8,_1865-Ans_02775-018-PL.tif">Moon, New York, 1865</a>
    by Lewis Morris Rutherfurd, public domain.
  </p>
</footer>

<style>
  .footer {
    padding-block: 2.5rem 1.875rem;
    font-size: var(--step-small);
  }

  .line {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: baseline;
    gap: 1.5rem;
  }

  .what,
  .who {
    color: var(--muted);
  }

  .who {
    text-align: right;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .credits {
    max-width: 70ch;
    margin-top: 2rem;
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .line {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .who {
      text-align: left;
    }
  }
</style>
