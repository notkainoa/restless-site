---
// Hero: the headline split around one frame showing Restless at 11:41 pm,
// the panel open over a build that's about to run with the lid shut.
import EyeMark from './EyeMark.astro';
import MenuBar from './frags/MenuBar.astro';
import Panel from './frags/Panel.astro';
import Terminal from './frags/Terminal.astro';
import { REPO_URL, type Release } from '../lib/release';

interface Props {
  release: Release;
}
const { release } = Astro.props;
---

<section id="top" class="hero">
  <header class="nav wrap" data-load style="--d:0ms">
    <a href="#top" class="mark" aria-label="Restless, back to top">
      <EyeMark id="nav" size={28} />
      <span>Restless</span>
    </a>
    <nav aria-label="Site" class="nav-links">
      <a class="plain-link" href={REPO_URL}>GitHub</a>
      <a class="button button-sm" href={release.downloadUrl}>Download for Mac</a>
    </nav>
  </header>

  <div class="stage wrap">
    <h1 class="split head">
      <span class="half first"><span class="mask"><span data-line style="--i:0">Lid shut.</span></span></span>
      <span class="half second"><span class="mask"><span data-line style="--i:1">Still running.</span></span></span>
    </h1>

    <div class="frame" data-ui data-load style="--d:200ms">
      <MenuBar time="Fri 11:41 PM" battery={86} glyph="eye-fill" open />
      <div class="desk-work">
        <Terminal title="release — make — 96×24" width={430}><span class="d">Last login: Fri Oct 23 23:38:02 on ttys001</span>
<span class="p">dev@MacBook-Pro release %</span> make release
<span class="d">23:41:07</span>  [   1/1284] Resolving packages
<span class="d">23:41:31</span>  [   9/1284] Fetching swift-argument-parser
<span class="d">23:41:52</span>  [  22/1284] Compiling Shared</Terminal>
      </div>
      <div class="desk-panel"><Panel lidOpen lidClosed percent={86} /></div>
    </div>
  </div>

  <div class="foot wrap" data-load style="--d:420ms">
    <p class="sentence">
      Restless is a menu bar app that keeps your Mac awake with the lid closed, so builds, downloads, SSH sessions
      and AI agents keep running.
    </p>
    <a class="button" href={release.downloadUrl}>Download for Mac</a>
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }

  /* Auto side margins would shrink flex children to their content. */
  .hero > .wrap {
    width: 100%;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.5rem;
    font-size: var(--step-small);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--step-body);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  /* The halves hold the edges; the frame sits between them. */
  .stage {
    --fw: min(46vw, 44rem);
    position: relative;
    flex: 1;
    display: grid;
    place-items: center;
    padding-block: 2rem;
  }

  .split {
    position: absolute;
    inset: 50% var(--margin) auto;
    display: flex;
    justify-content: space-between;
    z-index: 1;
    transform: translateY(-50%);
    font-size: clamp(2.5rem, 3.9vw, 4rem);
    line-height: 0.95;
    pointer-events: none;
  }

  .half {
    max-width: calc((100vw - var(--fw)) / 2 - var(--margin) - 1.5rem);
  }

  .mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
  }

  .frame {
    position: relative;
    width: var(--fw);
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    background: var(--surface);
    overflow: clip;
  }

  .desk-work {
    position: absolute;
    left: 18px;
    top: 46px;
  }

  .desk-panel {
    position: relative;
    display: flex;
    justify-content: flex-end;
    padding: 6px 14px 0;
  }

  .foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
  }

  .sentence {
    max-width: 34ch;
    font-size: var(--step-body);
    line-height: 1.45;
  }

  /* Phone and narrow tablet: the headline sits above the frame. */
  @media (max-width: 899px) {
    .hero {
      min-height: auto;
    }

    .stage {
      --fw: 100%;
      display: block;
      place-items: normal;
      padding-block: 0.5rem 1.5rem;
    }

    .split {
      position: static;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      justify-content: normal;
      transform: none;
      font-size: var(--step-head);
    }

    .half {
      max-width: none;
    }

    .half.second {
      text-align: right;
    }

    .frame {
      margin-top: 1.25rem;
    }

    .foot {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }

    .foot .button {
      min-height: 52px;
    }
  }

  @media (max-width: 599px) {
    .frame {
      aspect-ratio: 4 / 3;
    }

    /* The panel covers the frame on a phone; no sliver of Terminal behind it. */
    .desk-work {
      display: none;
    }
  }
</style>
