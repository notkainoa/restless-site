---
import EyeMark from './EyeMark.astro';
import Icon from './Icon.astro';
import { REPO_URL, type Release } from '../lib/release';

interface Props {
  release: Release;
}
const { release } = Astro.props;
---

<header class="site-header sticky top-0 z-50">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href="#top" class="flex items-center gap-2.5 rounded-lg" aria-label="Restless, back to top">
      <EyeMark id="hdr" size={26} />
      <span class="text-[1.0625rem] font-[620] tracking-[-0.02em]">Restless</span>
    </a>

    <nav class="flex items-center gap-1 sm:gap-2" aria-label="Site">
      <a href={REPO_URL} class="nav-link hidden sm:inline-flex">
        <Icon name="github" size={17} />
        GitHub
      </a>
      <a href={release.downloadUrl} class="btn btn-primary btn-sm ml-1">Download</a>
    </nav>
  </div>
</header>

<style>
  /* Clear over the hero; the material and its edge appear only once
     content scrolls underneath. */
  .site-header {
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease,
      border-color 200ms ease;
  }

  :global(.scrolled) .site-header {
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border-bottom-color: var(--line);
  }

  @media (prefers-reduced-transparency: reduce) {
    :global(.scrolled) .site-header {
      background: var(--bg);
      backdrop-filter: none;
    }
  }

  .nav-link {
    align-items: center;
    gap: 0.45rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 520;
    color: var(--ink-2);
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover {
      color: var(--ink);
      background: var(--surface-2);
    }
  }

</style>

<script>
  const root = document.documentElement;

  // Hairline under the header once the page has scrolled.
  const onScroll = () => root.classList.toggle('scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
