---
// "Large marks on tiles": no logos to show, so each tile carries a true
// fact in type. The heading tile is the one field of accent.
const tiles = [
  { name: 'Signed with a Developer ID', detail: 'Hardened runtime, secure timestamp.' },
  { name: 'Notarized by Apple', detail: 'Opens normally, no Gatekeeper warning.' },
  { name: 'Open source, MIT', detail: 'Every line on GitHub.' },
  { name: 'Updates with Sparkle', detail: 'Checks in the background, or right away.' },
  { name: 'Starts with keep-awake off', detail: 'Quitting always restores normal sleep.' },
  { name: 'macOS 26 or newer', detail: 'Native, for Apple silicon Macs.' },
];
---

<section id="proof" class="proof wrap" aria-labelledby="proof-title">
  <div class="board">
    <div class="tile head-tile" data-reveal>
      <h2 id="proof-title">Safe to leave on</h2>
    </div>
    {
      tiles.map((t, i) => (
        <div class="tile" data-reveal style={`--i:${i + 1}`}>
          <p class="name">{t.name}</p>
          <p class="detail">{t.detail}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .proof {
    padding-top: clamp(7rem, 14vw, 13rem);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }

  .tile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1rem;
    aspect-ratio: 3 / 2;
    padding: clamp(1rem, 1.7vw, 1.5rem);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .head-tile {
    grid-column: span 2;
    aspect-ratio: auto;
    background: var(--accent);
    color: var(--accent-ink);
  }

  .head-tile h2 {
    font-size: var(--step-head);
    line-height: 0.95;
    letter-spacing: -0.05em;
    max-width: 9ch;
  }

  .name {
    font-size: var(--step-lead);
    line-height: 1.1;
    letter-spacing: -0.025em;
    font-weight: 500;
    max-width: 14ch;
  }

  .detail {
    font-size: var(--step-small);
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }

    .head-tile {
      min-height: 120px;
    }

    .tile {
      aspect-ratio: auto;
      min-height: 9.5rem;
    }

    .name {
      font-size: 1.25rem;
    }
  }
</style>
