---
// Every Restless release, newest first. The list is rendered at build time
// and refreshed from /api/releases, so a release published after the last
// deploy still shows up. On /download it follows the install steps; on
// /downloads it's the whole page.
import VersionRow from './VersionRow.astro';
import { RELEASES_URL, type RestlessRelease } from '../../lib/release';

interface Props {
  releases: RestlessRelease[];
  /** The list is the page (/downloads): its heading is the h1. */
  page?: boolean;
}
const { releases, page = false } = Astro.props;
const sig = releases.map((r) => `${r.version}:${r.size}`).join();
const Heading = page ? 'h1' : 'h2';
---

<section id="all-versions" class:list={['versions', { page }]} aria-labelledby="versions-title">
  <div class="vhead wrap">
    <Heading id="versions-title" class="head" data-reveal>All versions</Heading>
    <p class="needs" data-reveal style="--i:1">
      Every version needs macOS 26 Tahoe or newer on a Mac with Apple silicon. Once installed, Restless updates
      itself.
    </p>
  </div>

  <div class="list" data-reveal style="--i:2">
    <ol class="rows" data-releases data-sig={sig}>
      {releases.map((release, i) => <VersionRow release={release} latest={i === 0} />)}
    </ol>
    {
      releases.length === 0 && (
        <p class="empty wrap" data-releases-empty>
          The list didn’t load. Every release is on{' '}
          <a class="link" href={RELEASES_URL}>
            GitHub
          </a>
          .
        </p>
      )
    }
  </div>

  <template id="version-row"><VersionRow /></template>
</section>

<style>
  /* Margin, not padding, so the All versions jump lands on the heading. */
  .versions {
    margin-top: clamp(7rem, 14vw, 13rem);
    scroll-margin-top: clamp(1.5rem, 4vw, 3rem);
  }

  .vhead {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
  }

  /* Alone on /downloads, it starts where the download page's headline does. */
  .versions.page {
    margin-top: 0;
    padding-top: clamp(2.5rem, 7vw, 6rem);
  }

  .head {
    grid-column: 1 / span 5;
  }

  .needs {
    grid-column: 7 / span 6;
    max-width: 44ch;
    font-size: var(--step-lead);
    line-height: 1.35;
    letter-spacing: -0.015em;
  }

  .list {
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 899px) {
    .vhead {
      display: block;
    }

    .needs {
      margin-top: 1.25rem;
    }
  }
</style>

<script>
  import { formatDate, formatSize } from '../../lib/format';
  import { downloadPageFor, type RestlessRelease } from '../../lib/release';
  import { loadReleases } from '../../lib/releases-client';

  function fill(li: Element, field: string, apply: (el: HTMLElement) => void) {
    li.querySelectorAll<HTMLElement>(`[data-f="${field}"]`).forEach(apply);
  }

  function row(template: HTMLTemplateElement, release: RestlessRelease, latest: boolean) {
    const li = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
    li.classList.toggle('is-latest', latest);
    fill(li, 'version', (el) => (el.textContent = release.version));
    fill(li, 'latest', (el) => (el.hidden = !latest));
    fill(li, 'date', (el) => {
      el.textContent = formatDate(release.publishedAt);
      el.setAttribute('datetime', release.publishedAt);
    });
    fill(li, 'size', (el) => (el.textContent = formatSize(release.size)));
    fill(li, 'notes', (el) => el.setAttribute('href', release.notesUrl));
    fill(li, 'url', (el) => {
      el.setAttribute('href', downloadPageFor(release.version, latest));
      el.setAttribute('aria-label', `Download Restless ${release.version}`);
      el.classList.toggle('quiet', !latest);
    });
    return li;
  }

  // Picks up releases published since the last deploy. If the API is down,
  // the list from the build stays.
  async function refreshVersions() {
    const list = document.querySelector<HTMLOListElement>('[data-releases]');
    const template = document.querySelector<HTMLTemplateElement>('#version-row');
    if (!list || !template) return;

    const releases = await loadReleases();
    if (!releases) return;

    const sig = releases.map((r) => `${r.version}:${r.size}`).join();
    if (list.dataset.sig !== sig) {
      list.replaceChildren(...releases.map((r, i) => row(template, r, i === 0)));
      list.dataset.sig = sig;
      document.querySelector('[data-releases-empty]')?.remove();
    }
  }

  refreshVersions();
</script>
