---
import EyeMark from './EyeMark.astro';
import Icon from './Icon.astro';
import { REPO_URL, type Release } from '../lib/release';

interface Props {
  release: Release;
}
const { release } = Astro.props;
---

<div class="cta card relative overflow-hidden px-6 py-14 text-center sm:px-12 sm:py-20" data-reveal>
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="relative flex flex-col items-center">
    <EyeMark id="cta" size={72} class="cta-icon" />
    <h2 class="t-title mt-7">Close the lid. <span class="text-ink-3">Keep going.</span></h2>
    <p class="t-lead mt-4 max-w-[30rem]">
      Download <code class="token">{release.assetName}</code>, unzip it, and move Restless to Applications.
    </p>

    <div class="mt-8 flex w-full flex-col items-center justify-center gap-3 sm:w-auto sm:flex-row">
      <a href={release.downloadUrl} class="btn btn-primary w-full sm:w-auto">
        <Icon name="download" size={18} class="nudge-down" />
        Download Restless {release.version}
      </a>
      <a href={release.notesUrl} class="btn btn-ghost w-full sm:w-auto">
        Release notes
        <Icon name="arrow-up-right" size={16} class="nudge" />
      </a>
    </div>

    <p class="mt-5 text-[0.8125rem] text-ink-3">Requires macOS 26 or newer on Apple silicon.</p>
    <p class="mt-6 max-w-[30rem] text-[0.8125rem] leading-relaxed text-ink-3">
      Coming from Amped? Restless copies your settings the first time it runs.{' '}
      <a class="link text-ink-2" href={`${REPO_URL}#moving-from-amped`}>Moving from Amped</a>
    </p>
  </div>
</div>

<style>
  .cta-glow {
    position: absolute;
    left: 50%;
    top: -60%;
    width: 120%;
    aspect-ratio: 2;
    translate: -50% 0;
    background: radial-gradient(closest-side, var(--glow), transparent 75%);
    opacity: 0.7;
  }

  .cta :global(.cta-icon) {
    filter: drop-shadow(0 16px 28px var(--glow));
  }
</style>
