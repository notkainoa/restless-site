---
import Icon, { type IconName } from './Icon.astro';

const items: { icon: IconName; title: string; sub: string }[] = [
  { icon: 'shield', title: 'Signed', sub: 'with a Developer ID' },
  { icon: 'seal', title: 'Notarized', sub: 'by Apple' },
  { icon: 'code', title: 'Open source', sub: 'MIT license' },
  { icon: 'refresh', title: 'Auto-updates', sub: 'with Sparkle' },
  { icon: 'laptop', title: 'macOS 26', sub: 'Tahoe or newer' },
];
---

<ul class="trust" aria-label="Trust and requirements">
  {
    items.map((item, i) => (
      <li class="trust-item" data-reveal style={`--d:${i}`}>
        <Icon name={item.icon} size={20} class="text-accent" />
        <span>
          <span class="block text-[0.9375rem] font-[600] tracking-[-0.012em]">{item.title}</span>
          <span class="block text-[0.8125rem] text-ink-3">{item.sub}</span>
        </span>
      </li>
    ))
  }
</ul>

<style>
  .trust {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1.4rem 0.25rem;
  }

  /* Phones: two columns, the last item centered on its own row. */
  .trust-item:last-child {
    grid-column: 1 / -1;
    justify-content: center;
    border-top: 1px solid var(--line);
  }

  .trust-item:nth-child(n + 3):not(:last-child) {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 52rem) {
    .trust {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .trust-item,
    .trust-item:last-child {
      grid-column: auto;
      justify-content: center;
      border-top: 0;
      padding: 1.75rem 0.5rem;
    }

    .trust-item:nth-child(n + 3):not(:last-child) {
      border-top: 0;
    }

    .trust-item + .trust-item {
      border-left: 1px solid var(--line);
    }
  }
</style>
