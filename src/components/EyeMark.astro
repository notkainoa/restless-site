---
// The Restless icon as inline SVG, geometry and colors copied from
// icon/restless-dark.svg (the site is dark only). When `live`, the moon iris is
// split onto its own layer, clipped to the eye opening so it can look around
// and slip under the lids like a real iris.
interface Props {
  id: string;
  size?: number | string;
  live?: boolean;
  class?: string;
  label?: string;
}

const { id, size = 32, live = false, class: className, label } = Astro.props;
const p = (name: string) => `${id}-${name}`;

const UPPER =
  'M178.23 520.43 C197.2 499.55 324.84 284.19 517.59 284.19 C610.51 284.19 718.4 330.45 845.77 520.44 L843.21 520.44 C838.72 520.44 681.15 368.93 514.56 368.93 C362.03 368.93 220.52 492.39 181.17 520.76 Z';
const LOWER =
  'M178.23 520.43 C282.55 669.47 381.43 757.45 511.39 757.45 C661.56 757.45 769.53 627.67 845.77 520.44 L845.77 519.44 L843.21 519.44 L843.21 520.44 C763.41 582.75 640.19 674.36 512.45 674.36 C425.37 674.36 320.7 633.91 181.17 520.76 L181.17 519.76 L178.23 519.43 Z';
// The opening between the lids: the inner edges of both lid shapes.
const OPENING =
  'M181.17 520.76 C220.52 492.39 362.03 368.93 514.56 368.93 C681.15 368.93 838.72 520.44 843.21 520.44 C763.41 582.75 640.19 674.36 512.45 674.36 C425.37 674.36 320.7 633.91 181.17 520.76 Z';

---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="96 96 832 832"
  width={size}
  height={size}
  class:list={['eyemark', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  data-eye={live ? '' : undefined}
  focusable="false"
>
  <defs>
    <linearGradient id={p('tile')} gradientUnits="userSpaceOnUse" x1="0" y1="96" x2="0" y2="928">
      <stop offset="0" stop-color="#251d6c"></stop>
      <stop offset="0.509" stop-color="#1e1755"></stop>
      <stop offset="1" stop-color="#181246"></stop>
    </linearGradient>
    {
      live && (
        <clipPath id={p('opening')}>
          <path d={OPENING} />
        </clipPath>
      )
    }
  </defs>

  <rect x="96" y="96" width="832" height="832" rx="196" ry="196" fill={`url(#${p('tile')})`}></rect>
  <rect x="98.25" y="98.25" width="827.5" height="827.5" rx="193.75" ry="193.75" fill="none" stroke="#3e3896" stroke-width="3"></rect>
  <rect x="96.75" y="96.75" width="830.5" height="830.5" rx="195.25" ry="195.25" fill="none" stroke="#100a2a" stroke-opacity="0.9" stroke-width="1.5"></rect>

  {
    live ? (
      <>
        <g clip-path={`url(#${p('opening')})`}>
          <g class="em-iris" data-eye-iris>
            <circle class="em-moon" cx="511.31" cy="522.4" r="119.5" />
          </g>
        </g>
        <g class="em-lids" data-eye-lids>
          <path class="em-lower" d={LOWER} />
          <path class="em-upper" d={UPPER} />
        </g>
      </>
    ) : (
      <>
        <path class="em-lower" d={LOWER} />
        <path class="em-upper" d={UPPER} />
        <circle class="em-moon" cx="511.31" cy="522.4" r="119.5" />
      </>
    )
  }
</svg>

<style>
  .eyemark {
    display: block;
    overflow: visible;
  }
  .em-upper {
    fill: #8370fa;
  }
  .em-lower {
    fill: #8572fb;
  }
  .em-moon {
    fill: #a998fd;
  }

  /* Live eye: lids part on load, then the moon rises into place. */
  .em-lids {
    transform-origin: 512px 520px;
    transform-box: view-box;
  }

  :global(.js) [data-eye] .em-lids {
    animation: eye-open 820ms cubic-bezier(0.23, 1, 0.32, 1) 160ms both;
  }

  :global(.js) [data-eye] .em-moon {
    transform-origin: 511px 522px;
    transform-box: view-box;
    animation: moon-rise 700ms cubic-bezier(0.23, 1, 0.32, 1) 420ms both;
  }

  @keyframes eye-open {
    from {
      transform: scaleY(0.06);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes moon-rise {
    from {
      opacity: 0;
      transform: translateY(46px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-eye] .em-lids,
    :global(.js) [data-eye] .em-moon {
      animation: none;
    }
  }
</style>
