---
// The Restless app icon as inline SVG, geometry and colours copied from
// icon/restless-dark.svg in the app repo. It's the brand's own asset, so its
// violet stays; the page around it doesn't use that colour anywhere else.
interface Props {
  id: string;
  size?: number | string;
  class?: string;
  label?: string;
}

const { id, size = 32, class: className, label } = Astro.props;
const tile = `${id}-tile`;

const UPPER =
  'M178.23 520.43 C197.2 499.55 324.84 284.19 517.59 284.19 C610.51 284.19 718.4 330.45 845.77 520.44 L843.21 520.44 C838.72 520.44 681.15 368.93 514.56 368.93 C362.03 368.93 220.52 492.39 181.17 520.76 Z';
const LOWER =
  'M178.23 520.43 C282.55 669.47 381.43 757.45 511.39 757.45 C661.56 757.45 769.53 627.67 845.77 520.44 L845.77 519.44 L843.21 519.44 L843.21 520.44 C763.41 582.75 640.19 674.36 512.45 674.36 C425.37 674.36 320.7 633.91 181.17 520.76 L181.17 519.76 L178.23 519.43 Z';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="96 96 832 832"
  width={size}
  height={size}
  class:list={['eyemark', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <defs>
    <linearGradient id={tile} gradientUnits="userSpaceOnUse" x1="0" y1="96" x2="0" y2="928">
      <stop offset="0" stop-color="#251d6c"></stop>
      <stop offset="0.509" stop-color="#1e1755"></stop>
      <stop offset="1" stop-color="#181246"></stop>
    </linearGradient>
  </defs>
  <rect x="96" y="96" width="832" height="832" rx="196" ry="196" fill={`url(#${tile})`}></rect>
  <path fill="#8572fb" d={LOWER}></path>
  <path fill="#8370fa" d={UPPER}></path>
  <circle fill="#a998fd" cx="511.31" cy="522.4" r="119.5"></circle>
</svg>

<style>
  .eyemark {
    display: block;
    flex: none;
  }
</style>
