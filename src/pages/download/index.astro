---
// /download: starts the download on a Mac, then shows how to install, a
// retry, and every version. /download?version=1.2.0 does the same for one
// version. Prerendered like the rest of the site; the download itself goes
// through /download/latest (or /download/1.2.0).
import Base from '../../layouts/Base.astro';
import '../../styles/download.css';
import Nav from '../../components/Nav.astro';
import Icon from '../../components/Icon.astro';
import Steps from '../../components/download/Steps.astro';
import Versions from '../../components/download/Versions.astro';
import Footer from '../../components/Footer.astro';
import { getLatestRelease, getReleases, LATEST_ZIP } from '../../lib/release';

const releases = (await getReleases()) ?? [];
const { version, assetName } = await getLatestRelease();
---

<Base
  title="Download Restless for Mac"
  description="Download Restless, the macOS menu bar app that keeps your Mac awake with the lid closed. Requires macOS 26 Tahoe or newer on Apple silicon."
>
  <script is:inline>
    // Decide before the first paint which state the top of the page shows.
    // Without JavaScript it shows "ready": a plain Download button.
    (() => {
      const ua = navigator.userAgent;
      // iPadOS asks for desktop sites as a Mac; only it has a touch screen.
      const iPad = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
      const mac = /Macintosh|Mac OS X/.test(ua) && !/iPhone|iPad|iPod/.test(ua) && !iPad;
      // Arriving at the list (Releases in the footer) means picking a version.
      const browsing = location.hash === '#all-versions';
      document.documentElement.dataset.state = !mac ? 'other' : browsing ? 'ready' : 'downloading';
    })();
  </script>

  <Nav home="/" download={false} />

  <main id="main">
    <section class="top wrap" aria-labelledby="download-title">
      <p class="retry" data-when="downloading" data-load style="--d:420ms">
        Download didn’t start? <a class="plain-link" href={LATEST_ZIP} data-zip>Try again</a>
      </p>

      <h1 id="download-title" class="head">
        <span class="mask"
          ><span data-line>
            <span data-when="downloading">Restless is downloading.</span>
            <span data-when="intel">Restless needs Apple silicon.</span>
            <span data-when="other">Restless is a Mac app.</span>
            <span data-when="ready">Download Restless.</span>
            <span data-when="missing">There’s no such version.</span>
          </span></span
        >
      </h1>

      <div class="words" data-load style="--d:200ms">
        <p class="state">
          <span data-when="downloading">
            Restless <span data-latest="version">{version}</span> is on its way to your Downloads folder. Three steps
            and it’s running.
          </span>
          <span data-when="intel">
            This Mac reports an Intel processor, and Restless only runs on Apple silicon. If that’s wrong, pick a version
            below.
          </span>
          <span data-when="other">Open this page on your Mac to download it. Every version is listed below.</span>
          <span data-when="ready">
            Restless <span data-latest="version">{version}</span> for Mac, signed and notarized by Apple.
          </span>
          <span data-when="missing">
            Restless <span data-latest="version">{version}</span> was never released. Pick a version below.
          </span>
        </p>
        <p class="needs">Requires macOS 26 Tahoe or newer on a Mac with Apple silicon.</p>
        <div class="actions">
          <a class="button" href={LATEST_ZIP} data-zip data-when="ready">Download for Mac</a>
          <a class="button quiet" href="#all-versions"><Icon name="arrow-down" /> All versions</a>
        </div>
      </div>
    </section>

    <Steps assetName={assetName} />
    <Versions releases={releases} />
  </main>
  <Footer />
</Base>

<style>
  /* Only the parts for the current state show. Without JavaScript there's
     no state, and the page reads as "ready". */
  :global(html:not([data-state])) [data-when]:not([data-when='ready']),
  :global(html[data-state='ready']) [data-when]:not([data-when='ready']),
  :global(html[data-state='downloading']) [data-when]:not([data-when='downloading']),
  :global(html[data-state='intel']) [data-when]:not([data-when='intel']),
  :global(html[data-state='other']) [data-when]:not([data-when='other']),
  :global(html[data-state='missing']) [data-when]:not([data-when='missing']) {
    display: none;
  }

  /* No install steps for a version that doesn't exist. */
  :global(html[data-state='missing'] .steps) {
    display: none;
  }

  .top {
    padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3.5rem, 7vw, 6rem);
  }

  /* "Didn't start?" sits above the headline, quiet until it's needed. */
  .retry {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0 0.35em;
    margin-bottom: 1.5rem;
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--muted);
    font-size: var(--step-small);
  }

  .retry a {
    color: var(--ink);
  }

  h1 {
    max-width: 24ch;
  }

  .mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
  }

  .words {
    max-width: 40rem;
  }

  .state {
    margin-top: 1.25rem;
    max-width: 34ch;
    font-size: var(--step-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .needs {
    margin-top: 0.75rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  @media (max-width: 599px) {
    .actions .button {
      width: 100%;
      min-height: 52px;
    }
  }
</style>

<style is:global>
  /* The All versions button glides down to the list. */
  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }
</style>

<script>
  import { LATEST_ZIP, VERSION, zipFor } from '../../lib/release';
  import { loadReleases } from '../../lib/releases-client';

  const root = document.documentElement;

  // A version picked from the list (/download?version=1.2.0, or v1.2.0 the
  // way the tags read). No ?version means the newest; one that isn't a
  // version at all can't be downloaded.
  const wanted = new URLSearchParams(location.search).get('version')?.trim().replace(/^v/i, '') || null;
  const chosen = wanted && VERSION.test(wanted) ? wanted : null;
  const malformed = wanted !== null && !chosen;
  const zip = chosen ? zipFor(chosen) : LATEST_ZIP;

  function show(version: string) {
    const values: Record<string, string> = { version, assetName: `Restless-${version}.zip` };
    for (const el of document.querySelectorAll<HTMLElement>('[data-latest]')) {
      const value = values[el.dataset.latest ?? ''];
      if (value) el.textContent = value;
    }
  }

  // Browsers can't reliably say which chip a Mac has. Chromium can report
  // the architecture; only a clear "x86" stops the download.
  async function reportsIntel(): Promise<boolean> {
    const uad = (
      navigator as Navigator & {
        userAgentData?: { getHighEntropyValues?(hints: string[]): Promise<{ architecture?: string }> };
      }
    ).userAgentData;
    if (!uad?.getHighEntropyValues) return false;
    try {
      return (await uad.getHighEntropyValues(['architecture'])).architecture === 'x86';
    } catch {
      return false;
    }
  }

  // The list from the build answers for most versions without a request. If
  // the API is down, give the version the benefit of the doubt.
  async function released(version: string): Promise<boolean> {
    const built = document.querySelectorAll('[data-releases] [data-f="version"]');
    if ([...built].some((el) => el.textContent?.trim() === version)) return true;
    const releases = await loadReleases();
    return !releases || releases.some((r) => r.version === version);
  }

  // The zip arrives as an attachment, so the page stays put. With ?auto, a
  // GitHub outage answers 204 instead of sending the visitor to GitHub.
  function startDownload() {
    location.assign(`${zip}?auto`);
  }

  async function autoDownload() {
    if (root.dataset.state !== 'downloading') return;
    if (malformed || (chosen && !(await released(chosen)))) {
      root.dataset.state = 'missing';
      return;
    }
    if (await reportsIntel()) {
      root.dataset.state = 'intel';
      return;
    }
    if (document.readyState === 'complete') startDownload();
    else addEventListener('load', startDownload, { once: true });
  }

  if (wanted) {
    show(chosen ?? wanted.slice(0, 16));
    for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-zip]')) a.href = zip;
  } else {
    // A release published since the last deploy is the one that downloads.
    loadReleases().then((releases) => releases && show(releases[0].version));
  }

  autoDownload();
</script>
