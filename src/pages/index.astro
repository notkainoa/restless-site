---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Switches from '../components/Switches.astro';
import Approve from '../components/Approve.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
import { getLatestRelease } from '../lib/release';

const release = await getLatestRelease();
---

<Base
  title="Restless: keep your Mac awake with the lid closed"
  description="Restless is a small, native macOS menu bar app that keeps your Mac awake with the lid closed, so SSH sessions, downloads, builds and AI agents keep running."
>
  <main id="main">
    <Hero release={release} />
    <Switches />
    <Approve />
    <Closing release={release} />
  </main>
  <Footer />
</Base>
